# AXIOM — Variables de entorno
#
# Copia este archivo como `.env` y completa los valores.
# `.env*` está en .gitignore: NUNCA subas secretos al repositorio.

# Base de datos
# SQLite por defecto. Para PostgreSQL: cambia el provider en prisma/schema.prisma
# y usa: postgresql://usuario:clave@host:5432/axiom?sslmode=require
DATABASE_URL=file:../db/custom.db
CRON_SECRET=

# Sesión y autenticación
# [REQUERIDA EN PRODUCCIÓN] Mínimo 32 caracteres aleatorios.
# Generar con:  openssl rand -base64 48
# En desarrollo, si falta, se usa un fallback inseguro con advertencia.
# El mini-servicio de chat necesita ESTE MISMO valor.
JWT_SECRET=

# Proveedor de inferencia
# Sin clave, se usa el proxy de desarrollo (z-ai-web-dev-sdk).
OPENROUTER_API_KEY=
DEFAULT_MODEL=deepseek/deepseek-chat-v4-flash
FALLBACK_MODEL=openai/gpt-5.4-mini

# Embeddings
# Sin token, se usa un sustituto local determinista de 256 dimensiones.
# Al configurarlo, la dimensión pasa a 1024: hay que reindexar los documentos.
HF_TOKEN=

# Almacén vectorial
# Sin URL, se usa el almacén en memoria (se pierde al reiniciar).
QDRANT_URL=
QDRANT_API_KEY=

# Pagos (Mercado Pago)
MERCADO_PAGO_ACCESS_TOKEN=
# [REQUERIDA EN PRODUCCIÓN] Sin este valor, el webhook rechaza toda petición.
MP_WEBHOOK_SECRET=
# R34-d — ventana de rotación: clave ANTERIOR aceptada mientras dura el cambio (ver docs/operacion/rotacion-mp-webhook-secret.md)
MP_WEBHOOK_SECRET_PREVIOUS=
# Modo de pruebas de facturación. Inerte en producción; déjala vacía.
ENABLE_DEV_BILLING=

# Red
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URLs de retorno para Mercado Pago (vacío = usa NEXT_PUBLIC_APP_URL).
PUBLIC_URL=

# Orígenes autorizados para el WebSocket del chat.
ALLOWED_ORIGINS=http://localhost:3000

# Mini-servicios
TTS_SERVICE_URL=http://localhost:3004

# Observabilidad (opcional; sin él, sólo logger JSON + tabla SystemEvent)
OTEL_EXPORTER_OTLP_ENDPOINT=
